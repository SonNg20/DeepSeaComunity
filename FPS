local function GetScriptPathFromFunc(fn)
    if type(fn) ~= "function" then return nil end
    local ok, fnEnv = pcall(getfenv, fn)
    if ok and type(fnEnv) == "table" and typeof(fnEnv.script) == "Instance" then
        return fnEnv.script:GetFullName()
    end
    if debug and type(debug.info) == "function" then
        local okS, src = pcall(debug.info, fn, "s")
        if okS and type(src) == "string" then
            return src
        end
    end
    return nil
end

local function MatchesAny(str, list)
    for _, pat in ipairs(list) do
        if string.find(str, pat, 1, true) then
            return true
        end
    end
    return false
end

local function DisableDeepBackgroundWork()
    local disabledCount = 0

    if Config.DisableBackgroundLoops and type(getconnections) == "function" then
        for _, signal in ipairs({ RunService.RenderStepped, RunService.Heartbeat, RunService.Stepped }) do
            local ok, conns = pcall(getconnections, signal)
            if ok and type(conns) == "table" then
                for _, conn in ipairs(conns) do
                    if conn and conn.Function and type(conn.Disable) == "function" then
                        local srcPath = GetScriptPathFromFunc(conn.Function)
                        if srcPath and not MatchesAny(srcPath, WhitelistPatterns) then
                            if MatchesAny(srcPath, BlacklistPatterns) then
                                if pcall(conn.Disable, conn) then
                                    disabledCount += 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if Config.DisableCustomPetSerialFX and type(getgc) == "function" and type(hookfunction) == "function" then
        pcall(function()
            for _, v in ipairs(getgc(false)) do
                if type(v) == "function" and debug and type(debug.info) == "function" then
                    local okN, fnName = pcall(debug.info, v, "n")
                    local okS, fnSrc = pcall(debug.info, v, "s")
                    if okN and fnName == "processSerialFX"
                        and okS and type(fnSrc) == "string"
                        and string.find(fnSrc, "CustomPet", 1, true)
                    then
                        hookfunction(v, function() end)
                        break
                    end
                end
            end
        end)
    end

    if Config.DisableFxNetworkEvents and type(getconnections) == "function" and NetworkFolder then
        for _, rName in ipairs({
            "Eggs_PlayOpenAnimation",
            "Exclusive Eggs: Animation",
            "Lootbox: Animation",
            "Chat Msg Hatches Tab",
            "Breakables_Bonus",
        }) do
            local remote = NetworkFolder:FindFirstChild(rName)
            if remote and remote:IsA("RemoteEvent") then
                for _, conn in ipairs(getconnections(remote.OnClientEvent)) do
                    pcall(conn.Disable, conn)
                end
            end
        end
    end

    pcall(collectgarbage, "collect")
    print(("[PS99 PumpkinTycoon Optimizer] Đã tắt %d tiến trình ngầm (giữ Hunt/Farm/Hatch/HUD)."):format(disabledCount))
end

