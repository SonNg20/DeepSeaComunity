local Connections = {}
local CreatedGuis = {}

local function Bind(sig, fn)
    if not sig then return nil end
    local ok, conn = pcall(function() return sig:Connect(fn) end)
    if ok and conn then
        table.insert(Connections, conn)
        return conn
    end
    return nil
end

env._PS99PumpkinOptStop = function()
    Config.Running = false
    for i = #Connections, 1, -1 do
        pcall(function() Connections[i]:Disconnect() end)
        Connections[i] = nil
    end
    for i = #CreatedGuis, 1, -1 do
        pcall(function() CreatedGuis[i]:Destroy() end)
        CreatedGuis[i] = nil
    end
    pcall(RunService.Set3dRenderingEnabled, RunService, true)
end

