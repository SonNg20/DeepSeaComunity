local EFFECT_CLASSES = {
    ParticleEmitter = true,
    Trail = true,
    Sparkles = true,
    Smoke = true,
    Fire = true,
    Beam = true,
}

local function isCharPart(inst)
    local char = LocalPlayer.Character
    return char and inst:IsDescendantOf(char)
end

local function optimizeInstance(v)
    if v:GetAttribute("XT_Opt") then
        return
    end
    v:SetAttribute("XT_Opt", true)

    if v:IsA("BasePart") and not v:IsA("Terrain") then
        v.CastShadow = false
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
        if v:IsA("MeshPart") then
            v.TextureID = ""
        end
        if not isCharPart(v) then
            v.LocalTransparencyModifier = 1
        end
    elseif EFFECT_CLASSES[v.ClassName] then
        v.Enabled = false
    elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
        v.Enabled = false
    elseif v:IsA("Decal") or v:IsA("Texture") then
        v.Transparency = 1
    elseif v:IsA("Highlight") or v:IsA("BillboardGui") then
        if not isCharPart(v) then
            v:Destroy()
        end
    end
end

