}

local function DestroyEffectOrHide(obj, preservePhysics)
    if not obj or not obj.Parent then return end

    if Config.BlockAllEffects and EffectClasses[obj.ClassName] then
        pcall(function()
            if obj:IsA("ParticleEmitter") then obj:Clear() end
            obj.Enabled = false
        end)
        pcall(obj.Destroy, obj)
        return
    end

    if obj:IsA("BasePart") then
        pcall(function()
            obj.Transparency = 1
            obj.CastShadow = false
            obj.Material = Enum.Material.SmoothPlastic
            if not preservePhysics then
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
            end
        end)
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        pcall(function() obj.Transparency = 1 end)
    elseif obj:IsA("SurfaceAppearance") then
        pcall(obj.Destroy, obj)
    elseif Config.MuteAllSounds and obj:IsA("Sound") then
        pcall(function()
            obj.Volume = 0
            obj:Stop()
        end)
    end
end

local function HideTreeVisual(root, preservePhysics)
    if not root or not root.Parent then return end
    DestroyEffectOrHide(root, preservePhysics)
    for _, d in ipairs(root:GetDescendants()) do
        DestroyEffectOrHide(d, preservePhysics)
    end
end

