local function ApplyGamePotatoMode()
    if not Config.EnableGamePotatoMode then return end
    local vars = Modules.Variables
    if type(vars) == "table" then
        pcall(function()
            vars.PotatoMode = true
            vars.EggPotatoMode = true
        end)
    end
    pcall(Workspace.SetAttribute, Workspace, "GlobalInstantHatch", true)
end
local function ApplyEngineAndLighting()
    if Config.TargetFPS and Config.TargetFPS > 0 and type(setfpscap) == "function" then
        pcall(setfpscap, Config.TargetFPS)
    end
    if Config.LowestRenderQuality then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
    end
    if Config.Disable3DRendering then
        pcall(RunService.Set3dRenderingEnabled, RunService, false)
    end
    if Config.HideDefaultCoreGui then
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
        end)
        pcall(function()
            local coreGui = game:GetService("CoreGui")
            local expChat = coreGui:FindFirstChild("ExperienceChat")
            if expChat then expChat:Destroy() end
        end)
    end
    if Config.OptimizeLightingAndTerrain then
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            Lighting.Brightness = 1
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") then
                    v.Enabled = false
                elseif v:IsA("Atmosphere") or v:IsA("Sky") then
                    pcall(v.Destroy, v)
                end
            end
            local t = Workspace.Terrain
            if t then
                t.Decoration = false
                t.WaterWaveSize = 0
                t.WaterWaveSpeed = 0
                t.WaterReflectance = 0
                t.WaterTransparency = 1
            end
        end)
    end
    if Config.MuteAllSounds then
        for _, s in ipairs(SoundService:GetDescendants()) do
            if s:IsA("Sound") then
                pcall(function() s.Volume = 0; s:Stop() end)
            end
        end
    end
end
