local function CleanupNonEventRAM(initialRun)
    if initialRun then
        if Config.RemoveNonEventAreas then
            for _, name in ipairs({ "PSX Portal", "PSX Hall" }) do
                local obj = Workspace:FindFirstChild(name)
                if obj then pcall(obj.Destroy, obj) end
            end
        end

        if Config.CleanUnusedAssets then
            local assets = ReplicatedStorage:FindFirstChild("Assets")
            if assets then
                for _, name in ipairs(UnusedAssetsFolders) do
                    local f = assets:FindFirstChild(name)
                    if f then pcall(f.Destroy, f) end
                end
            end
        end

        if Config.CleanUnusedDirectory then
            local dir = ReplicatedStorage:FindFirstChild("__DIRECTORY")
            if dir then
                for _, name in ipairs(UnusedDirectoryFolders) do
                    local f = dir:FindFirstChild(name)
                    if f then pcall(f.Destroy, f) end
                end
            end
        end
    end

    local things = Workspace:FindFirstChild("__THINGS")
    if initialRun and Config.CleanUnusedThingsFolders and things then
        for _, name in ipairs(UnusedThingsFolders) do
            local f = things:FindFirstChild(name)
            if f then pcall(f.Destroy, f) end
        end
    end

    if Config.ClearDebrisAndVFX then
        local debris = Workspace:FindFirstChild("__DEBRIS")
        if debris then
            for _, c in ipairs(debris:GetChildren()) do
                pcall(c.Destroy, c)
            end
        end

        local vfx = things and things:FindFirstChild("VFX")
        if vfx then
            for _, c in ipairs(vfx:GetChildren()) do
                pcall(c.Destroy, c)
            end
        end
    end
end

local function StripOtherPlayerChar(char)
    if not Config.StripOtherPlayers or not char or char == LocalPlayer.Character then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants")
            or d:IsA("ShirtGraphic") or d:IsA("CharacterMesh")
            or d:IsA("ParticleEmitter") or d:IsA("Animator")
        then
            pcall(d.Destroy, d)
        elseif d:IsA("BasePart") then
            pcall(function()
                d.Transparency = 1
                d.CastShadow = false
                d.CanCollide = false
                d.CanTouch = false
                d.CanQuery = false
            end)
        end
    end
end

local function HideFolderWithPhysics(folder)
    if not folder then return end
    HideTreeVisual(folder, true)
    Bind(folder.DescendantAdded, function(d)
        if Config.Running and Config.HideMapAndTycoons then
            task.defer(DestroyEffectOrHide, d, true)
        end
    end)
end

local function IsDynamicPumpkinWorkspaceObj(obj)
    if not obj or obj == Workspace.Terrain or obj:IsA("Camera") then return false end
    if obj.Name == "__THINGS" or obj.Name == "__DEBRIS" or obj.Name == "Map" then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    return obj:IsA("Folder") or obj:IsA("Model")
end

local function SetupPumpkinVisualHider()
    -- 1. Ẩn Map chính, PumpkinTycoonIslands & các Folder/Model spawn thẳng vào Workspace
    if Config.HideMapAndTycoons then
        HideFolderWithPhysics(Workspace:FindFirstChild("Map"))
        HideFolderWithPhysics(Workspace:FindFirstChild("PumpkinTycoonIslands"))

        for _, child in ipairs(Workspace:GetChildren()) do
            if IsDynamicPumpkinWorkspaceObj(child) then
                HideFolderWithPhysics(child)
            end
        end
        Bind(Workspace.ChildAdded, function(child)
            if Config.Running and Config.HideMapAndTycoons and IsDynamicPumpkinWorkspaceObj(child) then
                task.defer(HideFolderWithPhysics, child)
            end
        end)
    end

    local things = Workspace:FindFirstChild("__THINGS")
    if things then
        -- 2. Ẩn Tycoons, Plots, Instances & __INSTANCE_CONTAINER (giữ vật lý & Raycast)
        if Config.HideMapAndTycoons then
            for _, fName in ipairs({ "Tycoons", "Plots", "Instances", "__INSTANCE_CONTAINER" }) do
                HideFolderWithPhysics(things:FindFirstChild(fName))
            end
        end

        -- 3. Ẩn Pets (vẫn giữ CustomPet/PlayerPet hoạt động bình thường)
        local petsFolder = things:FindFirstChild("Pets")
        if Config.HidePets and petsFolder then
            HideTreeVisual(petsFolder, false)
            Bind(petsFolder.DescendantAdded, function(d)
                if Config.Running and Config.HidePets then
                    task.defer(DestroyEffectOrHide, d, false)
                end
            end)
        end

        -- 4. Ẩn Breakables (CHỈ ẨN, KHÔNG DESTROY -> vẫn farm bình thường)
        local breakablesFolder = things:FindFirstChild("Breakables")
        if Config.HideBreakables and breakablesFolder then
            HideTreeVisual(breakablesFolder, false)
            Bind(breakablesFolder.DescendantAdded, function(d)
                if Config.Running and Config.HideBreakables then
                    task.defer(DestroyEffectOrHide, d, false)
                end
            end)
        end
    end

    -- 5. Dọn nhân vật người chơi khác
    if Config.StripOtherPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                if plr.Character then task.defer(StripOtherPlayerChar, plr.Character) end
                Bind(plr.CharacterAdded, function(c)
                    if Config.Running then task.defer(StripOtherPlayerChar, c) end
                end)
            end
        end
        Bind(Players.PlayerAdded, function(plr)
            if plr ~= LocalPlayer then
                Bind(plr.CharacterAdded, function(c)
                    if Config.Running then task.defer(StripOtherPlayerChar, c) end
                end)
            end
        end)
    end
end

