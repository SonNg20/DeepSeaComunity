local function simplifyVisualTree(root)
    if not root then
        return
    end
    for _, desc in ipairs(root:GetDescendants()) do
        pcall(optimizeInstance, desc)
    end
end

local function clearChildren(parent)
    if not parent then
        return
    end
    for _, child in ipairs(parent:GetChildren()) do
        pcall(child.Destroy, child)
    end
end

local function stepOptimization()
    installOptimizationHooks()

    clearChildren(workspace:FindFirstChild("__DEBRIS"))

    local botsFolder = workspace:FindFirstChild("HalloweenGamesBots")
    if botsFolder then
        for _, botModel in ipairs(botsFolder:GetChildren()) do
            for _, child in ipairs(botModel:GetChildren()) do
                if child:IsA("BasePart") then
                    child.Transparency = 1
                    child.CastShadow = false
                else
                    pcall(child.Destroy, child)
                end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            for _, desc in ipairs(plr.Character:GetDescendants()) do
                if desc:IsA("BasePart") then
                    desc.Transparency = 1
                    desc.CastShadow = false
                elseif desc:IsA("Decal") or desc:IsA("Texture") then
                    desc.Transparency = 1
                elseif desc:IsA("Accessory") or desc:IsA("Clothing") or desc:IsA("ShirtGraphic") or desc:IsA("CharacterMesh") or desc:IsA("BillboardGui") then
                    pcall(desc.Destroy, desc)
                elseif EFFECT_CLASSES[desc.ClassName] then
                    desc.Enabled = false
                end
            end
        end
    end

    local things = workspace:FindFirstChild("__THINGS")
    if things then
        for _, folderName in ipairs(THINGS_BLOAT_FOLDERS) do
            clearChildren(things:FindFirstChild(folderName))
        end
    end

    for _, name in ipairs(WORLD_BLOAT_NAMES) do
        local obj = workspace:FindFirstChild(name)
        if obj then
            pcall(obj.Destroy, obj)
        end
    end

    local activeModel = things
        and things:FindFirstChild("__INSTANCE_CONTAINER")
        and things.__INSTANCE_CONTAINER:FindFirstChild("Active")
        and things.__INSTANCE_CONTAINER.Active:FindFirstChild("HalloweenGames")

    if activeModel then
        for _, delName in ipairs(HG_ACTIVE_DELETE_NAMES) do
            local target = activeModel:FindFirstChild(delName)
            if target then
                pcall(target.Destroy, target)
            end
        end
        local hub = activeModel:FindFirstChild("Hub")
        if hub then
            local props = hub:FindFirstChild("Props")
            if props then
                pcall(props.Destroy, props)
            end
            simplifyVisualTree(hub)
        end
        simplifyVisualTree(activeModel:FindFirstChild("ZONE_GROUND"))
        simplifyVisualTree(activeModel:FindFirstChild("ArenaSlots"))
    end

    local models = workspace:FindFirstChild("Models")
    local netFolder = ReplicatedStorage:FindFirstChild("Network")
    if models and netFolder and netFolder:FindFirstChild("RequestRegister") then
        for _, child in ipairs(models:GetChildren()) do
            if not LOBBY_MODELS_KEEP[child.Name] then
                pcall(child.Destroy, child)
            end
        end
        simplifyVisualTree(models:FindFirstChild("Pad"))
        simplifyVisualTree(models:FindFirstChild("GROUND"))
    end
end

task.spawn(function()
    while true do
        pcall(stepOptimization)
        task.wait(3)
    end
end)
