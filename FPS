local function InstallOrbRenderStub()
    local OrbClass = Modules.OrbClass
    if (not Config.HideOrb and not Config.HideLootbag) or type(OrbClass) ~= "table" then return end
    if rawget(OrbClass, "__orbHideStub") then return end

    local dummyFn = function() end
    local mt = {
        __index = {
            RenderStepped = function(self)
                if self._destroyed then return false end
                self._collected = true
                return false
            end,
            Destroy = function(self) self._destroyed = true end,
            RenderParticles = dummyFn,
            Combine = function() return false end,
            Collect = function(self) self._collected = true end,
        },
    }

    local function stubNew(id)
        return setmetatable({
            _id = id,
            _destroyed = false,
            _collected = true,
            _combinedIds = {},
        }, mt)
    end

    pcall(function()
        if type(hookfunction) == "function" and type(OrbClass.new) == "function" then
            hookfunction(OrbClass.new, stubNew)
        else
            local setro = env.setreadonly or setreadonly
            if type(setro) == "function" then pcall(setro, OrbClass, false) end
            OrbClass.new = stubNew
        end
        rawset(OrbClass, "__orbHideStub", true)
    end)
end

local function FireCollectOrbs(ids)
    if #ids == 0 then return end
    local remote = NetworkFolder and NetworkFolder:FindFirstChild("Orbs: Collect")
    if remote and remote:IsA("RemoteEvent") then
        pcall(remote.FireServer, remote, ids)
    elseif Modules.Network and type(Modules.Network.Fire) == "function" then
        pcall(Modules.Network.Fire, "Orbs: Collect", ids)
    end
end

local function SetupOrbLootbagListeners()
    if Modules.Network and type(Modules.Network.Fired) == "function" then
        local okSig, sig = pcall(Modules.Network.Fired, "Orbs: Create")
        if okSig and sig then
            Bind(sig, function(infoTable)
                if not Config.Running or not Config.AutoCollectOrb or type(infoTable) ~= "table" then return end
                local ids = {}
                for k, v in pairs(infoTable) do
                    local id = (type(v) == "table" and tonumber(v.id or v.uid)) or tonumber(v) or tonumber(k)
                    if id then
                        table.insert(ids, id)
                    end
                end
                FireCollectOrbs(ids)
            end)
        end
    end

    local things = Workspace:FindFirstChild("__THINGS")
    for _, folderName in ipairs({ "Orbs", "Lootbags" }) do
        local folder = things and things:FindFirstChild(folderName)
        if folder then
            Bind(folder.ChildAdded, function(obj)
                if not Config.Running or not obj then return end
                if Config.HideOrb or Config.HideLootbag then
                    pcall(HideTreeVisual, obj, false)
                    task.defer(function()
                        if obj and obj.Parent then
                            pcall(obj.Destroy, obj)
                        end
                    end)
                end
            end)
        end
    end
end

local function SweepOrbsAndLootbags()
    local things = Workspace:FindFirstChild("__THINGS")
    if not things then return end

    for _, folderName in ipairs({ "Orbs", "Lootbags" }) do
        local folder = things:FindFirstChild(folderName)
        if folder then
            local children = folder:GetChildren()
            if #children > 0 then
                if Config.AutoCollectOrb then
                    local ids = {}
                    for _, o in ipairs(children) do
                        local idNum = tonumber(o.Name)
                            or tonumber(o:GetAttribute("OrbID"))
                            or tonumber(o:GetAttribute("id"))
                        if idNum then
                            table.insert(ids, idNum)
                        end
                    end
                    FireCollectOrbs(ids)
                end
                if Config.HideOrb or Config.HideLootbag then
                    for _, o in ipairs(children) do
                        pcall(HideTreeVisual, o, false)
                        pcall(o.Destroy, o)
                    end
                end
            end
        end
    end
end

