local function SetupGlobalEffectBlocker()
    if not Config.BlockAllEffects then return end
    local fnFolder = Library and Library:FindFirstChild("Functions")
    if fnFolder then
        for _, name in ipairs({ "Emit", "EmitFast", "EmitOne" }) do
            local mod = fnFolder:FindFirstChild(name)
            if mod then
                local ok, fn = pcall(require, mod)
                if ok and type(fn) == "function" and type(hookfunction) == "function" then
                    pcall(hookfunction, fn, function() end)
                end
            end
        end
    end
    for _, d in ipairs(Workspace:GetDescendants()) do
        if EffectClasses[d.ClassName] then
            DestroyEffectOrHide(d, true)
        end
    end
    Bind(Workspace.DescendantAdded, function(d)
        if Config.Running and EffectClasses[d.ClassName] then
            task.defer(DestroyEffectOrHide, d, true)
        end
    end)
    if Workspace.CurrentCamera then
        Bind(Workspace.CurrentCamera.DescendantAdded, function(d)
            if Config.Running and EffectClasses[d.ClassName] then
                task.defer(DestroyEffectOrHide, d, true)
            end
        end)
    end
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        for _, d in ipairs(pGui:GetDescendants()) do
            if d:IsA("BillboardGui") or d:IsA("ParticleEmitter") then
                pcall(d.Destroy, d)
            end
        end
        Bind(pGui.DescendantAdded, function(d)
            if Config.Running and (d:IsA("BillboardGui") or d:IsA("ParticleEmitter")) then
                task.defer(function()
                    pcall(d.Destroy, d)
                end)
            end
        end)
    end
end
