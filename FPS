local frameCount = 0
local lastFpsClock = os.clock()
local currentFps = 0

local lastLbFetch = 0
local cachedLb = GetLeaderboardData()
local lastRenderedText = ""

local function UpdateHud()
    local now = os.clock()
    frameCount += 1

    local fpsElapsed = now - lastFpsClock
    if fpsElapsed >= 0.5 then
        currentFps = math.floor((frameCount / fpsElapsed) + 0.5)
        frameCount = 0
        lastFpsClock = now
    end

    if (now - lastLbFetch) >= 0.35 then
        lastLbFetch = now
        cachedLb = GetLeaderboardData()
    end

    local accName = (LocalPlayer and LocalPlayer.Name) or "Unknown"
    local rankStr = cachedLb.rank and ("#" .. FormatCommas(cachedLb.rank)) or "Unranked"
    local scoreStr = FormatCommas(cachedLb.score)

    local nextText = table.concat({
        accName,
        rankStr .. " | " .. scoreStr,
        "FPS: " .. tostring(currentFps),
    }, "\n")

    if nextText ~= lastRenderedText then
        lastRenderedText = nextText
        HudText.Text = nextText
    end
end

UpdateHud()
RunService.Heartbeat:Connect(function()
    if not HudGui.Parent then
        return
    end
    pcall(UpdateHud)
end)

