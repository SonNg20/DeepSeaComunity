local function FormatCommas(value, fallback)
    if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
        return fallback or "0"
    end
    local digits = string.format("%.0f", math.floor(value))
    return (digits:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

local function SafeRequire(parent, ...)
    if not parent then
        return nil
    end
    local cur = parent
    for _, name in ipairs({ ... }) do
        if not cur then
            return nil
        end
        cur = cur:FindFirstChild(name)
    end
    if not cur then
        return nil
    end
    local ok, mod = pcall(require, cur)
    return ok and mod or nil
end

local Library = ReplicatedStorage:FindFirstChild("Library")
local LeaderboardCmds = SafeRequire(Library, "Client", "LeaderboardCmds")
local PumpkinContestsUtil = SafeRequire(Library, "Util", "PumpkinContestsUtil")

local function GetLeaderboardData(customBoardId)
    if not Library then
        Library = ReplicatedStorage:FindFirstChild("Library")
    end
    if not LeaderboardCmds then
        LeaderboardCmds = SafeRequire(Library, "Client", "LeaderboardCmds")
    end
    if not PumpkinContestsUtil then
        PumpkinContestsUtil = SafeRequire(Library, "Util", "PumpkinContestsUtil")
    end

    local boardId = customBoardId
        or (PumpkinContestsUtil and PumpkinContestsUtil.BOARD_ID)
        or "PumpkinTycoonCatches"

    local rank, score = nil, 0

    if LeaderboardCmds and type(LeaderboardCmds.Get) == "function" then
        local okGet, state = pcall(LeaderboardCmds.Get, boardId)
        if okGet and type(state) == "table" then
            local myData = type(state.LocalPlayer) == "table" and state.LocalPlayer or nil
            if myData then
                local r = tonumber(myData.GlobalRank)
                if r and r >= 1 and r == r and r < math.huge then
                    rank = math.floor(r)
                end
                local s = tonumber(myData.Score)
                if s and s >= 0 and s == s and s < math.huge then
                    score = math.floor(s)
                end
            end
        end
    end

    return {
        rank = rank,
        score = score,
    }
end

local function MakeDraggable(guiObject)
    local dragging = false
    local activeInput = nil
    local dragStart = Vector2.zero
    local startPos = guiObject.Position

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = true
            activeInput = input
            dragStart = Vector2.new(input.Position.X, input.Position.Y)
            startPos = guiObject.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or input ~= activeInput then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
            guiObject.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == activeInput then
            dragging = false
            activeInput = nil
        end
    end)
end

