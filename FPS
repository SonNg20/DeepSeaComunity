local Connections = {}
local function Bind(sig, fn)
    if not sig then return nil end
    local ok, conn = pcall(function() return sig:Connect(fn) end)
    if ok and conn then
        table.insert(Connections, conn)
        return conn
    end
    return nil
end
env._PS99PumpkinOptStop = function()
    Config.Running = false
    for i = #Connections, 1, -1 do
        pcall(function() Connections[i]:Disconnect() end)
        Connections[i] = nil
    end
    if Config.Disable3DRendering then
        pcall(RunService.Set3dRenderingEnabled, RunService, true)
    end
end
local Library = ReplicatedStorage:WaitForChild("Library", 30)
local NetworkFolder = ReplicatedStorage:FindFirstChild("Network")
    or (Library and Library:FindFirstChild("Network"))
local function SafeRequire(parent, ...)
    local cur = parent
    for _, name in ipairs({ ... }) do
        if not cur then return nil end
        cur = cur:FindFirstChild(name) or cur:WaitForChild(name, 10)
    end
    if not cur then return nil end
    local ok, mod = pcall(require, cur)
    return ok and mod or nil
end
